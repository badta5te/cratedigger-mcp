{
  "$schema": "https://static.modelcontextprotocol.io/schemas/2025-12-11/server.schema.json",
  "name": "io.github.badta5te/runout-mcp",
  "title": "Runout for Discogs",
  "description": "Ask about your Discogs Collection and Wantlist, Releases and pressings, and Marketplace prices.",
  "repository": {
    "url": "https://github.com/badta5te/runout-mcp",
    "source": "github"
  },
  "version": "0.1.0",
  "packages": [
    {
      "registryType": "pypi",
      "identifier": "runout-mcp",
      "version": "0.1.0",
      "runtimeHint": "uvx",
      "transport": {
        "type": "stdio"
      },
      "environmentVariables": [
        {
          "name": "DISCOGS_TOKEN",
          "description": "Discogs personal access token from https://www.discogs.com/settings/developers",
          "isRequired": true,
          "isSecret": true
        },
        {
          "name": "DISCOGS_CURRENCY",
          "description": "Currency of prices",
          "isRequired": false,
          "default": "EUR",
          "choices": ["USD", "GBP", "EUR", "CAD", "AUD", "JPY", "CHF", "MXN", "BRL", "NZD", "SEK", "ZAR"]
        }
      ]
    }
  ]
}
